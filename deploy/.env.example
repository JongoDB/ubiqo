# Copy to .env next to docker-compose.yml and fill in.

# Postgres superuser password for the bundled database (required).
POSTGRES_PASSWORD=change-me

# Canonical public URL clients will use, e.g. https://ubiqo.example.com
# (required; MCP clients and the version handshake depend on it).
UBIQO_PUBLIC_URL=https://ubiqo.example.com

# Only when using the `caddy` profile: the domain to obtain TLS for.
UBIQO_DOMAIN=ubiqo.example.com

# info | debug
UBIQO_LOG_LEVEL=info

# Pin a released image instead of building locally (recommended in prod):
# UBIQO_IMAGE=ghcr.io/jongodb/ubiqo:v0.1.0
