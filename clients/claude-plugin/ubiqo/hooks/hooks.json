{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "ubiqo hook session-start", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "ubiqo hook session-end", "timeout": 10 }
        ]
      }
    ]
  }
}
